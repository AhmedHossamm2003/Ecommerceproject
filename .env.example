# Copy this file to .env before starting the environment.
# Replace every password with a unique local development value.

POSTGRES_DB=ecommerce_db
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace_with_a_strong_local_password
PGADMIN_PORT=5050

# Phase 2 ingestion retry and logging settings.
DB_CONNECT_TIMEOUT=5
DB_RETRY_ATTEMPTS=12
DB_RETRY_DELAY_SECONDS=5
LOG_LEVEL=INFO

# Phase 5 orchestration. Use an absolute path as seen by the Docker daemon.
# Docker Desktop on Windows example: /run/desktop/mnt/host/c/Users/you/project/data/raw
KESTRA_VERSION=v2.0.0
KESTRA_PORT=8080
KESTRA_DB_PASSWORD=replace_with_a_strong_local_password
KESTRA_ADMIN_USERNAME=admin@localhost
KESTRA_ADMIN_PASSWORD=replace_with_a_strong_local_password
PIPELINE_RAW_DATA_HOST_PATH=/absolute/path/to/ecommerce-sales-pipeline/data/raw
